# Thanelinc — environment template. Copy to .env.local (gitignored) and fill in.
# NEVER commit real secrets. Server-only vars must NOT be prefixed with NEXT_PUBLIC_.
#
# Every variable below must also be set on the deploy target. If the SMTP block is
# missing, the contact and self-check forms return 502 and name the missing
# variable in the server log.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://thanelinc.ng  (canonical domain, Q-005)

# --- Strapi ---
# The homepage fetches from lib/cms/client.ts; other pages still read lib/content/*.ts.
# No token: the `home` find/findOne and `email-log` create permissions are public.
STRAPI_API_URL=http://localhost:1346
# Production: https://cms.thanelinc.ng

# --- SMTP (Contact Us + self-check call requests) ---
# Server-only. Powers app/api/contact and app/api/self-check/call-request.
# Use port 587 with SMTP_SECURE=false (STARTTLS). Do not use 465 + secure=true:
# outbound 465 is blocked on some networks and fails as a 20s ETIMEDOUT.
SMTP_HOST=mail.thanelinc.ng
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=info@thanelinc.ng
# Optional. A copy of every sent email, delivered as BCC so it does not affect
# the reply path. Leave blank to disable the copy.
MAIL_COPY_TO=noreply@thanelinc.ng
