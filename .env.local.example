# Thanelinc — environment template. Copy to .env.local (gitignored) and fill in.
# NEVER commit real secrets. Server-only vars must NOT be prefixed with NEXT_PUBLIC_.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://thanelinc.ng  (canonical domain, Q-005)

# --- Strapi (wired for the homepage) ---
# The homepage fetches from lib/cms/client.ts; other pages still read lib/content/*.ts.
# Base URL lives in lib/config/site-config.ts (STRAPI_API_URL), not env.
# No token: the `home` find/findOne and `email-log` create permissions are public.

# --- SMTP (Contact Us + self-check call requests) ---
# Server-only. Powers app/api/contact and app/api/self-check/call-request.
# NOTE: values are currently hardcoded in lib/mail/config.ts — see the comment there.
SMTP_HOST=mail.thanelinc.ng
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=info@thanelinc.ng
