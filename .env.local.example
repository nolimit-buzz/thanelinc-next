# Thanelinc — environment template. Copy to .env.local (gitignored) and fill in.
# NEVER commit real secrets. Server-only vars must NOT be prefixed with NEXT_PUBLIC_.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://thanelinc.ng  (canonical domain, Q-005)

# --- Strapi (connected later by the client's team — W-025) ---
# The frontend reads content from lib/content/*.ts today. When Strapi is wired in,
# only the data-fetch layer changes; components stay untouched.
# STRAPI_API_URL=
# STRAPI_API_TOKEN=          # server-only. Never NEXT_PUBLIC_.

# --- Email capture (self-check summary + newsletter) ---
# NOT YET IMPLEMENTED. Both capture personal data and must not go live before
# the /privacy notice is published — see the launch gates in the handover workspace.
# EMAIL_PROVIDER_API_KEY=    # server-only
